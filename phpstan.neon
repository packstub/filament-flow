includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    # packstub/agents and laravel/ai are suggested, not installed: the Ask AI action is analysed against the test stubs.
    scanDirectories:
        - tests/Fixtures/Agents
    ignoreErrors:
        # HasWorkflows is applied by the host application's models.
        -
            identifier: trait.unused
            path: src/Concerns/HasWorkflows.php
        # Create record, Update record and Assign owner fill the model the workflow names at runtime
        # with the attributes typed on the node: there is no model class to check the keys against.
        -
            message: '#expects array<model property of Illuminate\\Database\\Eloquent\\Model, mixed>#'
            identifier: argument.type
            paths:
                - src/Nodes/Actions/AssignOwner.php
                - src/Nodes/Actions/CreateRecord.php
                - src/Nodes/Actions/UpdateRecord.php
