{
  "format": "packstub-flow/1",
  "key": "high-value-order-alert",
  "name": "High-value order alert",
  "category": "Sales",
  "description": "Tell the team in Slack and in the panel when an order over a threshold comes in. Pick the order model in the trigger.",
  "settings": {},
  "definition": {
    "nodes": [
      {
        "id": "trigger-created",
        "type": "trigger",
        "position": {
          "x": 0,
          "y": 120
        },
        "data": {
          "identifier": "Packstub\\Flow\\Nodes\\Triggers\\RecordCreated",
          "label": "Order created",
          "description": "Choose your order model here.",
          "config": {
            "model_class": null,
            "once": false
          }
        }
      },
      {
        "id": "condition-total",
        "type": "condition",
        "position": {
          "x": 320,
          "y": 120
        },
        "data": {
          "identifier": "Packstub\\Flow\\Nodes\\Conditions\\CompareValues",
          "label": "Over 500?",
          "description": null,
          "config": {
            "left": "{{ model.total }}",
            "operator": ">=",
            "value": "500"
          }
        }
      },
      {
        "id": "action-slack",
        "type": "action",
        "position": {
          "x": 660,
          "y": 20
        },
        "data": {
          "identifier": "Packstub\\Flow\\Nodes\\Actions\\SendSlackMessage",
          "label": "Slack: sales channel",
          "description": null,
          "config": {
            "webhook_url": "{{ secrets.slack_webhook }}",
            "message": ":tada: Order {{ model.id }} for {{ model.total | number:2 }} just came in. {{ model.url }}"
          }
        }
      },
      {
        "id": "action-notify",
        "type": "action",
        "position": {
          "x": 660,
          "y": 220
        },
        "data": {
          "identifier": "Packstub\\Flow\\Nodes\\Actions\\SendNotification",
          "label": "Notify the panel",
          "description": null,
          "config": {
            "title": "High-value order {{ model.id }}",
            "body": "{{ model.total | number:2 }} — open it to review.",
            "status": "success",
            "action_label": "Open order",
            "action_url": "{{ model.url }}"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "trigger-created",
        "sourceHandle": "output",
        "target": "condition-total",
        "targetHandle": "input"
      },
      {
        "id": "e2",
        "source": "condition-total",
        "sourceHandle": "true",
        "target": "action-slack",
        "targetHandle": "input"
      },
      {
        "id": "e3",
        "source": "condition-total",
        "sourceHandle": "true",
        "target": "action-notify",
        "targetHandle": "input"
      }
    ]
  }
}
