{
    "name": "packstub/filament-flow",
    "description": "Visual workflow automations for Filament panels: triggers, conditions and actions drawn on a canvas, run by your queue.",
    "keywords": [
        "packstub",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-v5",
        "filament-flow",
        "workflow",
        "workflows",
        "automation",
        "automations",
        "filament-automations",
        "flowchart",
        "no-code",
        "triggers"
    ],
    "homepage": "https://github.com/packstub/filament-flow",
    "support": {
        "issues": "https://github.com/packstub/filament-flow/issues",
        "source": "https://github.com/packstub/filament-flow",
        "docs": "https://packstub.dev/docs/filament-flow"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Ion Caliman",
            "email": "icaliman92@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "dragonmantank/cron-expression": "^3.3",
        "filament/filament": "^4.0 || ^5.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0",
        "spatie/laravel-model-states": "^2.14",
        "spatie/laravel-model-status": "^1.20",
        "spatie/laravel-tags": "^4.12"
    },
    "autoload": {
        "psr-4": {
            "Packstub\\Flow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\Flow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test",
        "build": "bun run build"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\Flow\\FlowServiceProvider"
            ],
            "aliases": {
                "Flow": "Packstub\\Flow\\Facades\\Flow"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
