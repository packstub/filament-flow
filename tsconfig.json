{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "noImplicitAny": false,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "types": [
            "vite/client",
            "node"
        ]
    },
    "include": [
        "resources/js/**/*",
        "tests/js/**/*",
        "tests/e2e/**/*",
        "vite.config.js",
        "vitest.config.js",
        "playwright.config.ts"
    ]
}
