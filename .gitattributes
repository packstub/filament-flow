# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# The dist archive ships what an install runs: src, config, database,
# resources/{dist,lang,templates,views}. Everything else is "export-ignore".
/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.editorconfig          export-ignore
/.prettierrc            export-ignore
/AGENTS.md              export-ignore
/CHANGELOG.md           export-ignore
/CLAUDE.md              export-ignore
/UPGRADING.md           export-ignore
/art                    export-ignore
/docs                   export-ignore
/tests                  export-ignore
/workbench              export-ignore
/testbench.yaml         export-ignore
/phpunit.xml            export-ignore
/phpunit.xml.dist       export-ignore
/phpstan.neon           export-ignore
/phpstan.neon.dist      export-ignore
/phpstan-baseline.neon  export-ignore
/pint.json              export-ignore
/package.json           export-ignore
/bun.lock               export-ignore
/tsconfig.json          export-ignore
/svelte.config.js       export-ignore
/vite.config.js         export-ignore
/vitest.config.js       export-ignore
/playwright.config.ts   export-ignore
/resources/js           export-ignore
/resources/css          export-ignore
